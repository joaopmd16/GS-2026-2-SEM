# Copie para .env (o .env NÃO vai para o Git). Tudo opcional.
# EMAIL_MODO=arquivo   -> grava .eml em saida/outbox (padrão, seguro para demo)
# EMAIL_MODO=smtp      -> envia de verdade usando as variáveis abaixo
EMAIL_MODO=arquivo
EMAIL_REMETENTE=robo@citizentech.exemplo
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# URL real/alternativa da página de serviços (senão usa dados_teste/portal_prefeitura.html)
PORTAL_URL=
# 1 = não chama a API de feriados (sem internet)
ROBO_OFFLINE=0
