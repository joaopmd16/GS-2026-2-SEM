# Copie para .env (o .env NUNCA vai para o git).
# Sem chave, a API funciona em "modo simplificado" (triagem por regras).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT=20
# Origens liberadas no CORS (separe por vírgula). Nunca use "*".
CORS_ORIGINS=http://localhost:8501
# Front-end: URL da API
API_URL=http://localhost:8000
